DISCORD_TOKEN=your_bot_token_here

# MongoDB is optional. Only needed for: top, topweek, topmonth, stats, Card commands.
# Leave empty and those commands simply won't work, everything else is fine.
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/onetap

# Set to true to auto-upload all custom emojis to the bot's application on startup.
# Useful for a public bot so every server gets correct emojis without manual setup.
# Set to false if you already have the emojis uploaded.
EMOJIS=true
